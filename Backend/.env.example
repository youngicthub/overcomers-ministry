# Port the Express API listens on locally.
PORT=5000

NODE_ENV=development

# Postgres connection string (Neon, Supabase, RDS, local Postgres, etc).
# postgres://user:password@host:5432/dbname?sslmode=require
#
# Note on Neon specifically: the connection string Neon's dashboard gives
# you by default includes "&channel_binding=require". Node's `pg` driver
# has inconsistent support for SCRAM channel binding and can hang
# silently during authentication instead of failing cleanly when that
# flag is present — if `db:push` or the server hang on "connecting" with
# no real error, remove "&channel_binding=require" from the string below
# and keep just "?sslmode=require".
DATABASE_URL=

# Shared secret that gates admin SIGN-UP only (src/routes/admin.ts).
# Anyone who has this token can create a new Media Admin account. Signing
# back IN afterwards only needs that admin's own password, not this
# token. Pick a long random string, share it privately with your team,
# and rotate it if it's ever exposed. Do NOT commit a real value here.
#
# Admin sign-up is disabled until this is set: POST /api/admin/signup
# returns 503 while it is empty.
MEDIA_ADMIN_ACCESS_TOKEN=

# Comma-separated list of origins the Frontend is served from, e.g.
# https://overcomers.church,https://www.overcomers.church
# Used for both CORS and CSRF (Origin-header) checks. If unset, only
# http://localhost:5173 and http://127.0.0.1:5173 are allowed — safe for
# local dev, but you MUST set this before deploying anywhere else, or the
# deployed frontend will not be able to sign in.
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Controls log verbosity (trace|debug|info|warn|error).
LOG_LEVEL=info
