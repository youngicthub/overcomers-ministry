# Port the Express API listens on locally.
PORT=5000

NODE_ENV=development

# Neon Postgres connection string.
# Get this from your Neon project dashboard -> Connection Details
# (use the "pooled connection" string). Looks like:
# postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Shared secret used to gate the Media Admin OTP login (artifacts/api-server/src/routes/admin.ts).
# Pick any long random string; whoever knows it can request an admin OTP.
MEDIA_ADMIN_ACCESS_TOKEN=

# Optional: where Media Admin session data is persisted between restarts.
# ADMIN_STORE_PATH=./data/admin-sessions.json
